{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcstats",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Many Minecraft servers, one Worker. Each server's data lives only in its own Durable Object (Tenant);
  // the DIRECTORY database only says which servers exist and holds the mcstats accounts. See README.md, "How servers are kept apart".
  "workers_dev": true,
  "preview_urls": false,

  // Static pages from ./public: the landing page (/), joining (/join), making a server (/new) and the account (/account).
  // The Worker runs first for the API, every server's pages (/s/<server>/...), the old season-1 archive
  // address (/s1/, now under the first server), and the stats page's file, which is only served inside a server.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/s1", "/s1/*", "/stats", "/stats.html",
      // the site's own pages, so their link-preview image gets a full address (src/index.js)
      "/", "/index.html", "/new", "/new.html", "/join", "/join.html", "/account", "/account.html"]
  },

  // The mod versions shown on /new, read from mod/ (scripts/mod-info.mjs writes src/modinfo.gen.js).
  "build": { "command": "node scripts/mod-info.mjs" },

  // No cron: each server checks itself on its own alarm (src/tenant.js). Said out loud, because leaving
  // "triggers" out keeps whatever cron an earlier deploy set up.
  "triggers": { "crons": [] },

  "d1_databases": [
    {
      // Which servers exist: slug, name, hashed join password, hashed mod keys, owner. And the mcstats
      // accounts: email, hashed password, hashed session tokens (src/account.js). No stats.
      // Create it with `npx wrangler d1 create mcstats-directory` and put its id here.
      "binding": "DIRECTORY",
      "database_name": "mcstats-directory",
      "database_id": "2710840a-3a87-4057-80a0-98507e6a0d0f",
      "migrations_dir": "directory-migrations"
    },
    {
      // The single-server database from before. Nothing reads it at runtime any more; it stays bound
      // until scripts/copy-tenant.mjs has copied it into the first server and you've checked the counts.
      "binding": "DB",
      "database_name": "mcstats",
      "database_id": "b45c9980-b769-42cf-94e2-421c6a20931b",
      "migrations_dir": "migrations"
    }
  ],

  // TENANT is one per server, named by its id, and holds all of that server's data in its own SQLite
  // (src/tenant.js). LINK, PRESENCE and LIVEVIEW are one per server too, named by the same id:
  // LINK holds the server mod's WebSocket, which carries chat sent from the dashboard into the game
  // (src/link.js). PRESENCE pushes who's online to open pages as players join and leave (src/presence.js).
  // LIVEVIEW passes the live view between the server mod and the admins watching it (src/liveview.js).
  // LIMITER counts join, sign-in and code attempts (src/limiter.js).
  "durable_objects": {
    "bindings": [
      { "name": "TENANT", "class_name": "Tenant" },
      { "name": "LINK", "class_name": "ServerLink" },
      { "name": "PRESENCE", "class_name": "Presence" },
      { "name": "LIVEVIEW", "class_name": "LiveRelay" },
      { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ServerLink"] },
    { "tag": "v2", "new_sqlite_classes": ["Presence"] },
    { "tag": "v3", "new_sqlite_classes": ["LiveRelay"] },
    { "tag": "v4", "new_sqlite_classes": ["Tenant", "Limiter"] }
  ],

  // Secrets (npx wrangler secret put NAME), never put here:
  //   SESSION_SECRET     signs the viewer cookies and is part of every account password's hash (at least 32
  //                      characters; `openssl rand -base64 48`). Changing it makes everyone reset their password.
  //   RESEND_API_KEY     sends the account codes
  //   OPS_TOKEN          for scripts/copy-tenant.mjs (at least 32 characters)
  //   SUPER_ADMIN_EMAIL  site operators: can do everything on any server they sign in to
  //   CHAT_INGEST_TOKEN  the old shared mod token; still accepted for the first server (LEGACY_SLUG)
  //   MC_SERVER          the old server address; copied into the first server's settings once
  "vars": {
    // Every server runs the mod, which needs this Minecraft version; player pages draw armor and items with its textures.
    "MC_VERSION": "26.2",
    // The server the old shared CHAT_INGEST_TOKEN, the old /s1/ address and the old D1 data belong to.
    "LEGACY_SLUG": "eggsmp",
    "EMAIL_FROM": "mcstats <noreply@emptyconsole.com>",
    "MAX_SERVERS_PER_OWNER": "3"
  },

  "observability": { "enabled": true }
}
